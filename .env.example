# Copy this file to .env and fill in real values. Every key below is read
# from the environment by config/settings/*.py — none has a committed
# secret default, not even a development one. `docker-compose.yml` loads
# this file automatically via env_file.
#
# Blank values below are required and MUST be filled in before the app will
# start (see config/settings/base.py `env()` — it raises rather than
# silently booting with a missing secret). Non-blank values are safe,
# non-secret defaults already appropriate for local dev.

# --- Which settings module to load ---
# Local dev: config.settings.dev · Production: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Core Django ---
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DJANGO_TIME_ZONE=America/New_York
DJANGO_LANGUAGE_CODE=en-us
DJANGO_LOG_LEVEL=INFO

# Required when DJANGO_SETTINGS_MODULE=config.settings.prod — comma-
# separated, NO hardcoded domain default (same reasoning as SECRET_KEY: a
# default here would be silently wrong for whichever deploy is NOT
# currently running). Leave unset in dev (dev.py hard-codes localhost).
#
# Current test deployment: DJANGO_ALLOWED_HOSTS=leslie.testground.shop
#                           CSRF_TRUSTED_ORIGINS=https://leslie.testground.shop
# At the real-domain cutover (PROJECT-SCOPE.md §1), change to:
#   DJANGO_ALLOWED_HOSTS=lesliehale-astrology.com,www.lesliehale-astrology.com
#   CSRF_TRUSTED_ORIGINS=https://lesliehale-astrology.com,https://www.lesliehale-astrology.com
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Must describe the same database as POSTGRES_* below when running via
# docker-compose (db service resolves by its service name "db").
DATABASE_URL=postgres://leslie:changeme@db:5432/leslie_hale_astrology
POSTGRES_DB=leslie_hale_astrology
POSTGRES_USER=leslie
POSTGRES_PASSWORD=changeme

# --- Wagtail ---
WAGTAIL_SITE_NAME=Leslie Hale Astrology
# Required — no default. Local dev: http://localhost:8000
# Test deployment: https://leslie.testground.shop
# Production (after cutover): https://lesliehale-astrology.com
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Wagtail's own Site model (wagtail_sites, separate from ALLOWED_HOSTS and
# CANONICAL_DOMAIN below) has a hostname/port that Wagtail's initial
# migration sets to "localhost"/80 and that Page.full_url / .get_url()
# resolve against when no request is available — e.g. the RSS feed
# (apps/blog/feeds.py builds item_link() from BlogPost.full_url). Left at
# "localhost" in production, every RSS item link would silently read
# "http://localhost/...". Leave both blank in local dev (the "localhost"
# default is already correct there). Set both for the test deployment and
# again at cutover — docker/entrypoint.sh syncs the default Site record to
# these values as a deliberate one-off step (see RUN_MIGRATIONS below); it
# is a no-op if left blank.
#   Test deployment: WAGTAIL_SITE_HOSTNAME=leslie.testground.shop, WAGTAIL_SITE_PORT=443
#   Cutover:         WAGTAIL_SITE_HOSTNAME=lesliehale-astrology.com, WAGTAIL_SITE_PORT=443
WAGTAIL_SITE_HOSTNAME=
WAGTAIL_SITE_PORT=443

# --- Email (SMTP; ignored in dev, which uses the console backend) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Payments (Stripe) — booking-payments owns usage ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ISO 4217 code, e.g. USD. Leslie is US-based — see config/settings/base.py's
# own comment for why this is a setting rather than a code literal, and for
# the zero-decimal-currency caution (JPY, KRW, VND, etc.) before ever
# changing this to anything other than a two-decimal currency like USD.
BOOKING_CURRENCY=USD

# --- Analytics — seo-analytics owns usage ---
# Not actually read anywhere (see config/settings/base.py's own comment) —
# the GA4 measurement ID Leslie controls lives in Wagtail admin -> Settings
# -> Analytics (AnalyticsSettings), not here. Left committed only because
# it was already part of this file.
GOOGLE_ANALYTICS_ID=

# --- SEO — seo-analytics owns usage ---
# Apex domain every canonical URL / sitemap entry / structured-data URL is
# built against. NO hardcoded default (same SECRET_KEY reasoning — see
# config/settings/base.py). Leave unset in dev.
#   Test deployment: CANONICAL_DOMAIN=leslie.testground.shop
#   Cutover:         CANONICAL_DOMAIN=lesliehale-astrology.com
CANONICAL_DOMAIN=

# Controls robots.txt (apps/core/views.py:robots_txt). Leave false/unset
# everywhere except the real production deploy — including the current
# leslie.testground.shop test deployment, even though it also runs
# config.settings.prod. Set this to true ONLY once the host really is
# lesliehale-astrology.com. Getting this wrong the "indexed staging" way
# is the embarrassing failure; getting it wrong the "un-indexed
# production" way is just a quick flag flip.
SEARCH_ENGINE_INDEXING_ALLOWED=false

# --- HSTS (config/settings/prod.py) — ignored under config.settings.dev ---
# Defaults below (0 / false / false) are deliberately safe for a throwaway
# test host: SECURE_HSTS_SECONDS=0 means Django sends no
# Strict-Transport-Security header at all. HSTS preload is effectively
# irreversible once picked up by a browser vendor, and a year-long max-age
# on a host that might later serve plain HTTP again would break every
# browser that ever visited — do not set these to production values until
# the real lesliehale-astrology.com cutover, and only after confirming TLS
# is stable there. See config/settings/prod.py's own comment for the full
# reasoning and the exact cutover values.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# --- Entrypoint behaviour ---
# Deliberate migration step, not implicit on every container start. Set
# true for a single one-off migrate run (or the lone dev container); leave
# false/unset for additional web replicas in a multi-replica deploy.
RUN_MIGRATIONS=true

# Gunicorn worker count — tune per host resources; 2-4 is a reasonable
# starting point for small shared/VPS hosting.
WEB_CONCURRENCY=3

# --- docker-compose.prod.yml only — ignored by the dev stack ---
# Host paths bind-mounted for Postgres data and media (Leslie's portrait,
# the imported blog images) so both survive `docker compose down` and a
# redeploy, and so the operator can back them up directly with an ordinary
# filesystem tool. See docker-compose.prod.yml's own comment for the
# backup obligation this does NOT cover on its own.
POSTGRES_DATA_DIR=./data/postgres
MEDIA_DIR=./data/media
# Host port the production web container is published on. Whatever
# reverse proxy / TLS edge sits in front of it (see prod.py's
# SECURE_PROXY_SSL_HEADER assumption) should point here.
WEB_PORT=8000
