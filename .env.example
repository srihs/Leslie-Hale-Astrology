# Copy this file to .env and fill in real values. Every key below is read
# from the environment by config/settings/*.py — none has a committed
# secret default, not even a development one. `docker-compose.yml` loads
# this file automatically via env_file.
#
# Blank values below are required and MUST be filled in before the app will
# start (see config/settings/base.py `env()` — it raises rather than
# silently booting with a missing secret). Non-blank values are safe,
# non-secret defaults already appropriate for local dev.

# --- Which settings module to load ---
# Local dev: config.settings.dev · Production: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Core Django ---
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DJANGO_TIME_ZONE=Pacific/Auckland
DJANGO_LANGUAGE_CODE=en-nz
DJANGO_LOG_LEVEL=INFO

# Production only — comma-separated. Leave unset in dev (dev.py hard-codes
# localhost). In prod these already default to lesliehale-astrology.com if
# left blank; only set them here to add a staging host.
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Must describe the same database as POSTGRES_* below when running via
# docker-compose (db service resolves by its service name "db").
DATABASE_URL=postgres://leslie:changeme@db:5432/leslie_hale_astrology
POSTGRES_DB=leslie_hale_astrology
POSTGRES_USER=leslie
POSTGRES_PASSWORD=changeme

# --- Wagtail ---
WAGTAIL_SITE_NAME=Leslie Hale Astrology
# Required — no default. Local dev: http://localhost:8000
# Production: https://lesliehale-astrology.com
WAGTAILADMIN_BASE_URL=http://localhost:8000

# --- Email (SMTP; ignored in dev, which uses the console backend) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Payments (Stripe) — booking-payments owns usage ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Analytics — seo-analytics owns usage ---
GOOGLE_ANALYTICS_ID=

# --- Entrypoint behaviour ---
# Deliberate migration step, not implicit on every container start. Set
# true for a single one-off migrate run (or the lone dev container); leave
# false/unset for additional web replicas in a multi-replica deploy.
RUN_MIGRATIONS=true

# Gunicorn worker count — tune per host resources; 2-4 is a reasonable
# starting point for small shared/VPS hosting.
WEB_CONCURRENCY=3
